# Prep — environment template (committed; NO real values here).
# Copy to .env.local and fill in from Supabase → Project Settings → API.

# --- Client-safe (exposed to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Server-only (NEVER sent to the browser) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Supabase MCP server (local tooling only; not used by the app) ---
# The MCP server reads these from the shell Claude Code is launched in.
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ACCESS_TOKEN=your-personal-access-token
# AI provider (server-only — never NEXT_PUBLIC)
GEMINI_API_KEY=your-gemini-api-key
# Optional: 'mock' for local dev / tests without a provider
AI_PROVIDER=
# Optional: 'paid' once billing is enabled, so cost_usd records real charges
AI_BILLING_MODE=
# Optional: overrides the 25/day default (tests use 500)
AI_DAILY_CALL_CAP=

CORPUS_EMBED_USER_ID=
